# PRE-PROD profile: real ONDC pre-production network. Copy to bap/.env once you are whitelisted.
# Prereqs: portal.ondc.org profile complete + pre-prod whitelisting for this subscriber_id + domain with valid SSL.
PORT=4000

# Your whitelisted subscriber_id = the public FQDN that serves this BAP over HTTPS
BAP_ID=ondc.your-domain.com
BAP_URI=https://ondc.your-domain.com/ondc

# From ONDC developer-docs (registry/Onboarding of Participants.md); pre-prod gateway per ONDC env table.
GATEWAY_SEARCH_URL=https://preprod.gateway.ondc.org/search
REGISTRY_LOOKUP_URL=https://preprod.registry.ondc.org/v2.0/lookup
REGISTRY_SUBSCRIBE_URL=https://preprod.registry.ondc.org/ondc/subscribe
# ONDC pre-prod registry encryption public key (prod is different: MCowBQYDK2VuAyEAwASk2D4O3p/tuD8f9sNQAQlwOU2w3DAumcOK9qHCFwI=)
ONDC_PUBLIC_KEY=MCowBQYDK2VuAyEARa/WcMCzNQp4DWjvTI4DK7vHL6EdaHqN4GjFIu9wxxM=

CITY_CODE=std:011
CALLBACK_TIMEOUT_MS=30000
SIGNATURE_CHECK=on
# Must match your commercial agreement
BUYER_FINDER_FEES_PERCENTAGE=1
STATIC_TERMS_URL=https://ondc.your-domain.com/terms

# Keys live in bap/.env.keys (run `pnpm keys`). Use separate keys per environment.
