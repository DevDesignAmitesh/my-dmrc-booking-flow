# LOCAL profile: talks to the mock network in bpp-mock (registry + gateway + sellers on :4001).
# These are also the built-in defaults, so copying this file is optional.
PORT=4000
BAP_ID=localhost:4000
BAP_URI=http://localhost:4000/ondc

GATEWAY_SEARCH_URL=http://localhost:4001/gateway/search
REGISTRY_LOOKUP_URL=http://localhost:4001/registry/v2.0/lookup
REGISTRY_SUBSCRIBE_URL=http://localhost:4001/registry/subscribe
# The mock registry's encryption public key (fixed, see bpp-mock/src/registry.ts)
ONDC_PUBLIC_KEY=MCowBQYDK2VuAyEAXfvDTRUhUnbEk88VLF7VYiJE405d+QfBdJYa28ZuxWc=

CITY_CODE=std:011
CALLBACK_TIMEOUT_MS=30000
SIGNATURE_CHECK=on
BUYER_FINDER_FEES_PERCENTAGE=1

# Keys live in bap/.env.keys (run `pnpm keys`)
